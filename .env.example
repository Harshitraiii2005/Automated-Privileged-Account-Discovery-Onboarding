# Lab secrets for the AutoOnboard docker compose lab (all accounts are fictional).
# `make lab-gen` copies this file to .env and replaces every change-me with a random value.
# .env is git-ignored. Never commit it.
LDAP_ADMIN_PASSWORD=change-me
LDAP_SCANNER_PASSWORD=change-me
LDAP_ROTATOR_PASSWORD=change-me
# Bearer token for state-changing AutoOnboard API calls (POST /api/approvals).
AUTOONBOARD_API_TOKEN=change-me
